# PostgreSQL — `docker compose up -d postgres` fournit une instance locale
# compatible avec ces identifiants par défaut.
DATABASE_URL="postgresql://logiflow:logiflow@localhost:5433/logiflow"

# Redis — réservé à la file BullMQ pour les notifications asynchrones (V1.5+).
# Pas encore consommé par le code ; `docker compose up -d redis` le prépare.
REDIS_URL="redis://localhost:6379"

# JWT — générez une valeur aléatoire d'au moins 32 caractères en production.
# ex: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"

NODE_ENV="development"
