# Dependencies
node_modules/

# Next.js
.next/
out/

# Env files — jamais commités, seuls les .example le sont
.env
.env.local
.env.test
.env*.local

# Prisma
prisma/*.db

# Documents utilisateurs (CIN, permis, cartes grises...) — jamais commités ;
# stockage local de développement uniquement, voir document-storage.ts
storage/

# Logs
*.log
npm-debug.log*

# Tests
coverage/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json

# Claude Code local runtime/state — ignored by default (scheduled_tasks.lock,
# caches, and any other machine-local files land here). The shared AI
# governance assets are explicitly un-ignored below so they are
# version-controlled and shared across clones.
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**

# TypeScript incremental build cache
*.tsbuildinfo
